# carica — optional local settings. Copy to .env only if you need to change something.
#
# THIS PROJECT USES NO API KEYS. There is no key to paste, here or in the app.
# Every stage runs as a `codex exec` call, and the Codex CLI carries its own sign-in:
#
#     codex login          # once per computer, in a Terminal window
#
# If you find a key, token or password in a .env for this project, it is doing nothing.
# Nothing below is required — leave the file absent and the defaults shown apply.

# --- Codex CLI ---

# Model the reasoning stages ask Codex for. Overridable per stage in packages/pipeline/src/stages.js,
# and per run with `carica run --model <name>`.
CARICA_CODEX_MODEL=gpt-5-codex

# There is no drawing-model setting. S10 is an agent: it uses whatever renderer it can
# actually reach on this machine and records an honest fallback when it can reach none,
# which is why a run manifest says `models.image: agent-selected`. Setting
# CARICA_IMAGE_MODEL only relabels that manifest field; it does not choose a renderer.

# Only if the Codex CLI is installed somewhere off PATH.
# CARICA_CODEX_BIN=/usr/local/bin/codex

# Where the Codex CLI keeps its own sign-in. Read (never written) by the readiness check.
# Set this only if you have already set it for the CLI itself. Default: ~/.codex
# CODEX_HOME=
