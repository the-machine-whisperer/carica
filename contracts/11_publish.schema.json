{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/11_publish.schema.json",
  "title": "S11 publish — human checkpoint decisions and export manifest",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "decisions"],
  "properties": {
    "schema_version": {},
    "stage": { "const": "publish" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "description": "Written by the human editor through the React app. The pipeline never self-approves.",
      "items": {
        "type": "object",
        "required": ["story_id", "concept_id", "decision", "decided_at", "decided_by"],
        "properties": {
          "story_id": { "type": "string" },
          "concept_id": { "type": "string" },
          "decision": { "type": "string", "enum": ["approved", "revision_requested", "rejected"] },
          "decided_at": { "$ref": "_defs.schema.json#/definitions/isoDateTime" },
          "decided_by": { "type": "string" },
          "editor_note": { "type": "string" },
          "brief_path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ledger_appended": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ledger ids written to history/ledger.jsonl. Feeds the originality dimension on the next run."
    }
  },
  "additionalProperties": false
}
