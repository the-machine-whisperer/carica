{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/09_gate.schema.json",
  "title": "S9 gate — independent editorial standards adjudication",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "policy_sha", "verdicts"],
  "properties": {
    "schema_version": {},
    "stage": { "const": "gate" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "policy_sha": {
      "type": "string",
      "description": "SHA of config/editorial-policy.md as adjudicated against. Pins which version of the rules applied."
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["story_id", "concept_id", "verdict", "checks"],
        "properties": {
          "story_id": { "type": "string" },
          "concept_id": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "REVISE", "BLOCK"] },
          "checks": {
            "type": "array",
            "minItems": 1,
            "description": "One row per policy clause evaluated. A verdict without a clause citation is not a verdict.",
            "items": {
              "type": "object",
              "required": ["clause", "result", "reasoning"],
              "properties": {
                "clause": {
                  "type": "string",
                  "description": "Section reference into config/editorial-policy.md, e.g. '§2.1 antisemitic visual tropes'."
                },
                "result": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
                "reasoning": { "type": "string", "minLength": 15 }
              },
              "additionalProperties": false
            }
          },
          "revision_asks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required when verdict is REVISE. Specific and actionable, not 'make it less risky'."
          },
          "block_reason": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "REVISE" } } },
            "then": { "required": ["revision_asks"], "properties": { "revision_asks": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "verdict": { "const": "BLOCK" } } },
            "then": { "required": ["block_reason"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
