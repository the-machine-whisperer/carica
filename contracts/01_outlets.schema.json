{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/01_outlets.schema.json",
  "title": "S1 outlets — Israeli outlets ranked by reach and engagement",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "outlets", "data_basis"],
  "properties": {
    "schema_version": {},
    "stage": { "const": "outlets" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "data_basis": {
      "type": "string",
      "enum": ["public_ranking_pages", "mixed"],
      "description": "Honest declaration of where the reach numbers came from. There is no paid-API option and no key: every reach number here is a proxy derived from free, open, no-login sources. 'public_ranking_pages' means the numbers came only from publicly readable ranking or traffic-estimate pages. 'mixed' means those pages combined with on-site engagement signals the agent counted itself (talkbacks, cross-citations, social footprint). Neither is measured traffic — do not quote either as a visit count."
    },
    "outlets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id", "name_he", "name_en", "homepage", "language", "lean",
          "reach_score", "engagement_score", "authority_score",
          "composite_score", "rank", "signals", "feeds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name_he": { "type": "string" },
          "name_en": { "type": "string" },
          "homepage": { "$ref": "_defs.schema.json#/definitions/url" },
          "language": { "$ref": "_defs.schema.json#/definitions/lang" },
          "lean": { "$ref": "_defs.schema.json#/definitions/politicalLean" },
          "ownership": { "type": "string" },
          "paywall": { "type": "string", "enum": ["none", "metered", "hard", "partial"] },
          "robots_allowed": { "type": "boolean" },
          "reach_score": { "$ref": "_defs.schema.json#/definitions/score0to100" },
          "engagement_score": { "$ref": "_defs.schema.json#/definitions/score0to100" },
          "authority_score": { "$ref": "_defs.schema.json#/definitions/score0to100" },
          "composite_score": { "$ref": "_defs.schema.json#/definitions/score0to100" },
          "rank": { "type": "integer", "minimum": 1 },
          "signals": {
            "type": "array",
            "minItems": 1,
            "description": "Every score above must be derivable from these. Each carries an evidence_id.",
            "items": {
              "type": "object",
              "required": ["kind", "value", "evidence_id"],
              "properties": {
                "kind": {
                  "type": "string",
                  "description": "Every kind here must be obtainable from a free, publicly readable page or a local command — no API key, no account. 'public_traffic_rank' is an ordinal position read off an open ranking list; 'estimated_monthly_visits' is a third-party estimate, never measured traffic.",
                  "enum": [
                    "public_traffic_rank",
                    "estimated_monthly_visits",
                    "semrush_rank",
                    "ahrefs_traffic",
                    "tgi_exposure_pct",
                    "talkback_volume",
                    "social_footprint",
                    "rotter_mentions",
                    "cross_citation"
                  ]
                },
                "value": { "type": ["number", "string"] },
                "unit": { "type": "string" },
                "observed_at": { "$ref": "_defs.schema.json#/definitions/isoDateTime" },
                "evidence_id": { "$ref": "_defs.schema.json#/definitions/evidenceId" }
              },
              "additionalProperties": false
            }
          },
          "feeds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "kind"],
              "properties": {
                "url": { "$ref": "_defs.schema.json#/definitions/url" },
                "kind": { "type": "string", "enum": ["rss", "atom", "index", "api", "sitemap"] },
                "section": { "type": "string" },
                "verified": { "type": "boolean", "description": "Agent actually fetched it and it parsed." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
