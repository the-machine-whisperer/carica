{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/07_concepts.schema.json",
  "title": "S7 ideate — three divergent visual concepts per candidate, then a selection",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "candidates"],
  "properties": {
    "schema_version": {},
    "stage": { "const": "ideate" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["story_id", "concepts", "selected_primary", "selected_alternate", "critique"],
        "properties": {
          "story_id": { "type": "string" },
          "concepts": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "description": "Deliberately divergent. Three variations on one idea is a failure of this stage.",
            "items": {
              "type": "object",
              "required": ["id", "metaphor_family", "gag_line", "metaphor", "cast", "composition", "read_order"],
              "properties": {
                "id": { "type": "string", "pattern": "^cp_[a-z0-9_-]+$" },
                "metaphor_family": {
                  "type": "string",
                  "enum": [
                    "classical_allegory",
                    "mundane_domestic",
                    "machine_apparatus",
                    "theatre_stage",
                    "natural_force",
                    "sport_contest",
                    "medical_clinical",
                    "childhood_playground"
                  ]
                },
                "gag_line": {
                  "type": "string",
                  "minLength": 10,
                  "description": "The joke in one sentence. If it cannot be said in one sentence it will not read in one frame."
                },
                "metaphor": { "type": "string", "minLength": 20 },
                "cast": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["figure", "caricature_handles"],
                    "properties": {
                      "figure": { "type": "string" },
                      "caricature_handles": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "string" },
                        "description": "Signature attributes only — glasses, posture, hair, a known gesture, a habitual prop. NEVER physiognomy coded to ethnicity or religion (see config/editorial-policy.md §2)."
                      },
                      "role_in_frame": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                },
                "composition": { "type": "string", "minLength": 20 },
                "read_order": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string" },
                  "description": "What the eye hits first, second, third. Legibility is designed, not hoped for."
                },
                "lettering_plan": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text_he", "placement"],
                    "properties": {
                      "text_he": { "type": "string" },
                      "text_en_gloss": { "type": "string" },
                      "placement": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                },
                "legibility_self_score": { "$ref": "_defs.schema.json#/definitions/score0to10" }
              },
              "additionalProperties": false
            }
          },
          "selected_primary": { "type": "string" },
          "selected_alternate": { "type": "string" },
          "critique": {
            "type": "string",
            "minLength": 40,
            "description": "Why the primary beat the others, and the strongest objection to it."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
