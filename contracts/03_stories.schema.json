{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/03_stories.schema.json",
  "title": "S3 cluster — articles merged into story clusters across outlets",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "stories"],
  "properties": {
    "schema_version": {},
    "stage": { "const": "cluster" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title_he", "title_en", "summary_en", "member_item_ids", "outlet_breadth", "first_seen", "last_updated"],
        "properties": {
          "id": { "type": "string", "pattern": "^st_[a-z0-9_-]+$" },
          "title_he": { "type": "string", "minLength": 1 },
          "title_en": { "type": "string", "minLength": 1, "description": "English gloss, so a non-Hebrew-reading editor can follow the run." },
          "summary_en": { "type": "string", "minLength": 20 },
          "member_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "outlet_breadth": {
            "type": "integer",
            "minimum": 1,
            "description": "Distinct outlets covering this story. Breadth is itself an impact signal."
          },
          "outlet_ids": { "type": "array", "items": { "type": "string" } },
          "figures_raw": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Names as they appeared, pre-normalisation. Hebrew variants expected (נתניהו / ביבי / בנימין נתניהו)."
          },
          "name_variants_merged": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["canonical", "variants"],
              "properties": {
                "canonical": { "type": "string" },
                "variants": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "description": "Auditable record of the Hebrew name merges — the step naive dedup cannot do."
          },
          "first_seen": { "$ref": "_defs.schema.json#/definitions/isoDateTime" },
          "last_updated": { "$ref": "_defs.schema.json#/definitions/isoDateTime" },
          "engagement_total": {
            "type": "object",
            "properties": {
              "comments": { "type": "integer", "minimum": 0 },
              "shares": { "type": "integer", "minimum": 0 },
              "rotter_threads": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "unclustered_item_ids": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
