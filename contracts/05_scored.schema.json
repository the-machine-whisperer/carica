{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carica.local/contracts/05_scored.schema.json",
  "title": "S5 score — caricature fitness rubric, nine dimensions with justification and evidence",
  "type": "object",
  "allOf": [{ "$ref": "_defs.schema.json#/definitions/envelope" }],
  "required": ["schema_version", "stage", "run_id", "generated_at", "agent", "weights", "candidates"],
  "definitions": {
    "dimension": {
      "type": "object",
      "required": ["score", "justification"],
      "properties": {
        "score": { "$ref": "_defs.schema.json#/definitions/score0to10" },
        "justification": {
          "type": "string",
          "minLength": 30,
          "description": "Why this score and not one point higher or lower. This is what the editor reads."
        },
        "evidence_quote_he": {
          "type": "string",
          "description": "Verbatim Hebrew from the source. Empty only when the dimension is not text-derived (e.g. originality)."
        },
        "evidence_gloss_en": { "type": "string" },
        "source_url": { "$ref": "_defs.schema.json#/definitions/url" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {},
    "stage": { "const": "score" },
    "run_id": {},
    "generated_at": {},
    "agent": {},
    "weights": {
      "type": "object",
      "description": "Echoed from config/weights.yaml. Emitted separately from sub-scores so the editor can re-weight and re-rank in the UI without a re-run.",
      "required": [
        "absurdity", "spice", "legibility", "comedic_mechanism",
        "controversy", "impact", "shelf_life", "originality", "legal_risk"
      ],
      "properties": {
        "absurdity": { "type": "number" },
        "spice": { "type": "number" },
        "legibility": { "type": "number" },
        "comedic_mechanism": { "type": "number" },
        "controversy": { "type": "number" },
        "impact": { "type": "number" },
        "shelf_life": { "type": "number" },
        "originality": { "type": "number" },
        "legal_risk": { "type": "number", "maximum": 0, "description": "Negative weight — risk subtracts." }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["story_id", "rank", "dimensions", "weighted_total", "arithmetic", "verdict_summary"],
        "properties": {
          "story_id": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "dimensions": {
            "type": "object",
            "required": [
              "absurdity", "spice", "legibility", "comedic_mechanism",
              "controversy", "impact", "shelf_life", "originality", "legal_risk"
            ],
            "properties": {
              "absurdity": { "$ref": "#/definitions/dimension" },
              "spice": { "$ref": "#/definitions/dimension" },
              "legibility": { "$ref": "#/definitions/dimension" },
              "comedic_mechanism": { "$ref": "#/definitions/dimension" },
              "controversy": { "$ref": "#/definitions/dimension" },
              "impact": { "$ref": "#/definitions/dimension" },
              "shelf_life": { "$ref": "#/definitions/dimension" },
              "originality": { "$ref": "#/definitions/dimension" },
              "legal_risk": { "$ref": "#/definitions/dimension" }
            },
            "additionalProperties": false
          },
          "weighted_total": { "type": "number" },
          "arithmetic": {
            "type": "string",
            "minLength": 20,
            "description": "The sum written out, e.g. '0.15*8 + 0.10*7 + ... - 0.20*3 = 6.42'. Makes the ranking arguable rather than oracular."
          },
          "verdict_summary": {
            "type": "string",
            "minLength": 20,
            "description": "One paragraph: why this story would or would not make a good cartoon."
          },
          "originality_conflicts": {
            "type": "array",
            "description": "Prior ledger entries this candidate resembles.",
            "items": {
              "type": "object",
              "required": ["ledger_id", "similarity_note"],
              "properties": {
                "ledger_id": { "type": "string" },
                "similarity_note": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
